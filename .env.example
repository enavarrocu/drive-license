# Secret de session (>= 32 caractères aléatoires). Obligatoire en production.
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-random-characters
# Chemin du fichier SQLite. Dans Coolify : /data/permis.db avec un volume persistant monté sur /data
NUXT_DB_PATH=./data/permis.db
# Autoriser la création de comptes (true/false). Mettre false une fois les comptes créés.
NUXT_ALLOW_REGISTRATION=true
# Noms d'utilisateur administrateurs (séparés par des virgules) : accès à /reports (erreurs signalées).
NUXT_ADMIN_USERS=
